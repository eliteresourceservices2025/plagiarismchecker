# Shared team API keys (server-side, optional).
#
# When set, everyone using this app can run checks with no per-user
# sign-up or Settings configuration — the server uses these automatically.
# Anyone can still override with their own personal key in the app's
# Settings panel if the shared pool runs low.
#
# Get a Serper.dev key (2,500 one-time free queries, no card):
#   https://serper.dev
# Get a SerpApi key (250 free queries/month, recurring, no card):
#   https://serpapi.com
#
# Copy this file to .env.local and fill in real values — .env.local is
# git-ignored and never committed. On Vercel, set these in
# Project Settings > Environment Variables instead of committing a file.

SERPER_API_KEY=

# Optional second Serper account — tried automatically once the first key
# is exhausted, before ever falling back to SerpApi. Leave blank if you
# only have one Serper key.
SERPER_API_KEY_2=

SERPAPI_API_KEY=

# Shared credit tracking (optional, but recommended once the shared keys
# above are set). Install the "Upstash Redis" integration from Vercel's
# Marketplace (Project → Integrations) and it auto-injects these — you
# shouldn't need to set them by hand. Without them, everything above still
# works; the credit gauge in the app just won't be live/shared, and
# Settings > Usage will say so.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
